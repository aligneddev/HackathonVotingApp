{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.43.8.12551",
      "templateHash": "11987807007404778481"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "environmentName": {
      "type": "string",
      "defaultValue": "dev",
      "allowedValues": [
        "dev",
        "prod"
      ]
    },
    "appName": {
      "type": "string",
      "defaultValue": "kl-hackathon-voting"
    },
    "sqlAdminLogin": {
      "type": "string",
      "defaultValue": "sqladmin",
      "metadata": {
        "description": "SQL server administrator login used for initial bootstrap access."
      }
    },
    "extraCorsOrigins": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "defaultValue": [],
      "metadata": {
        "description": "Additional CORS origins to allow beyond the deployed Static Web App (e.g. the other environment SWA URL)."
      }
    },
    "sqlAdminPassword": {
      "type": "securestring"
    }
  },
  "resources": {
    "sql": {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "sql",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "environmentName": {
            "value": "[parameters('environmentName')]"
          },
          "appName": {
            "value": "[parameters('appName')]"
          },
          "sqlAdminLogin": {
            "value": "[parameters('sqlAdminLogin')]"
          },
          "sqlAdminPassword": {
            "value": "[parameters('sqlAdminPassword')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.43.8.12551",
              "templateHash": "3749569672378859194"
            }
          },
          "parameters": {
            "location": {
              "type": "string"
            },
            "environmentName": {
              "type": "string",
              "allowedValues": [
                "dev",
                "prod"
              ]
            },
            "appName": {
              "type": "string"
            },
            "sqlAdminLogin": {
              "type": "string",
              "defaultValue": "sqladmin",
              "metadata": {
                "description": "SQL server administrator login used for initial bootstrap access."
              }
            },
            "sqlAdminPassword": {
              "type": "securestring"
            }
          },
          "variables": {
            "nameSeed": "[toLower(replace(replace(format('{0}{1}', parameters('appName'), parameters('environmentName')), '-', ''), '_', ''))]",
            "uniqueSuffix": "[take(uniqueString(resourceGroup().id, parameters('appName'), parameters('environmentName')), 6)]",
            "serverName": "[take(format('{0}sql{1}', variables('nameSeed'), variables('uniqueSuffix')), 63)]",
            "databaseName": "[format('{0}-db', parameters('appName'))]"
          },
          "resources": [
            {
              "type": "Microsoft.Sql/servers",
              "apiVersion": "2023-08-01",
              "name": "[variables('serverName')]",
              "location": "[parameters('location')]",
              "properties": {
                "administratorLogin": "[parameters('sqlAdminLogin')]",
                "administratorLoginPassword": "[parameters('sqlAdminPassword')]",
                "minimalTlsVersion": "1.2",
                "publicNetworkAccess": "Enabled"
              }
            },
            {
              "type": "Microsoft.Sql/servers/firewallRules",
              "apiVersion": "2023-08-01",
              "name": "[format('{0}/{1}', variables('serverName'), 'AllowAzureServices')]",
              "properties": {
                "startIpAddress": "0.0.0.0",
                "endIpAddress": "0.0.0.0"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Sql/servers', variables('serverName'))]"
              ]
            },
            {
              "type": "Microsoft.Sql/servers/databases",
              "apiVersion": "2023-08-01",
              "name": "[format('{0}/{1}', variables('serverName'), variables('databaseName'))]",
              "location": "[parameters('location')]",
              "sku": {
                "name": "GP_S_Gen5_1",
                "tier": "GeneralPurpose",
                "family": "Gen5",
                "capacity": 1
              },
              "properties": {
                "autoPauseDelay": 60,
                "minCapacity": "[json('0.5')]"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Sql/servers', variables('serverName'))]"
              ]
            }
          ],
          "outputs": {
            "serverFqdn": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Sql/servers', variables('serverName')), '2023-08-01').fullyQualifiedDomainName]"
            },
            "databaseName": {
              "type": "string",
              "value": "[variables('databaseName')]"
            },
            "sqlAdminLogin": {
              "type": "string",
              "value": "[parameters('sqlAdminLogin')]"
            }
          }
        }
      }
    },
    "staticWebApp": {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "staticWebApp",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "environmentName": {
            "value": "[parameters('environmentName')]"
          },
          "appName": {
            "value": "[parameters('appName')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.43.8.12551",
              "templateHash": "358074521632840632"
            }
          },
          "parameters": {
            "location": {
              "type": "string"
            },
            "environmentName": {
              "type": "string",
              "allowedValues": [
                "dev",
                "prod"
              ]
            },
            "appName": {
              "type": "string"
            }
          },
          "variables": {
            "staticWebAppName": "[format('{0}-{1}-swa', parameters('appName'), parameters('environmentName'))]"
          },
          "resources": [
            {
              "type": "Microsoft.Web/staticSites",
              "apiVersion": "2024-11-01",
              "name": "[variables('staticWebAppName')]",
              "location": "[parameters('location')]",
              "sku": {
                "name": "Free",
                "tier": "Free"
              },
              "properties": {
                "stagingEnvironmentPolicy": "Enabled",
                "allowConfigFileUpdates": true,
                "buildProperties": {
                  "appLocation": "src/frontend",
                  "outputLocation": "dist",
                  "apiLocation": ""
                }
              }
            }
          ],
          "outputs": {
            "staticWebAppName": {
              "type": "string",
              "value": "[variables('staticWebAppName')]"
            },
            "staticWebAppDefaultHostName": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Web/staticSites', variables('staticWebAppName')), '2024-11-01').defaultHostname]"
            }
          }
        }
      }
    },
    "appService": {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "appService",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "environmentName": {
            "value": "[parameters('environmentName')]"
          },
          "appName": {
            "value": "[parameters('appName')]"
          },
          "sqlConnectionString": {
            "value": "[format('Server=tcp:{0},1433;Initial Catalog={1};Persist Security Info=False;User ID={2};Password={3};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;', reference('sql').outputs.serverFqdn.value, reference('sql').outputs.databaseName.value, reference('sql').outputs.sqlAdminLogin.value, parameters('sqlAdminPassword'))]"
          },
          "corsOrigins": {
            "value": "[union(createArray(format('https://{0}', reference('staticWebApp').outputs.staticWebAppDefaultHostName.value)), parameters('extraCorsOrigins'))]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "languageVersion": "2.0",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.43.8.12551",
              "templateHash": "17618205435583295970"
            }
          },
          "parameters": {
            "location": {
              "type": "string"
            },
            "environmentName": {
              "type": "string",
              "allowedValues": [
                "dev",
                "prod"
              ]
            },
            "appName": {
              "type": "string"
            },
            "sqlConnectionString": {
              "type": "securestring"
            },
            "corsOrigins": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "defaultValue": []
            }
          },
          "variables": {
            "copy": [
              {
                "name": "corsOriginSettings",
                "count": "[length(parameters('corsOrigins'))]",
                "input": {
                  "name": "[format('Cors__AllowedOrigins__{0}', copyIndex('corsOriginSettings'))]",
                  "value": "[parameters('corsOrigins')[copyIndex('corsOriginSettings')]]"
                }
              }
            ],
            "planName": "[format('{0}-{1}-plan', parameters('appName'), parameters('environmentName'))]",
            "webAppName": "[format('{0}-{1}-api', parameters('appName'), parameters('environmentName'))]"
          },
          "resources": {
            "appServicePlan": {
              "type": "Microsoft.Web/serverfarms",
              "apiVersion": "2024-11-01",
              "name": "[variables('planName')]",
              "location": "[parameters('location')]",
              "sku": {
                "name": "F1",
                "tier": "Free"
              },
              "kind": "linux",
              "properties": {
                "reserved": true
              }
            },
            "webApp": {
              "type": "Microsoft.Web/sites",
              "apiVersion": "2024-11-01",
              "name": "[variables('webAppName')]",
              "location": "[parameters('location')]",
              "properties": {
                "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
                "httpsOnly": true,
                "siteConfig": {
                  "linuxFxVersion": "DOTNETCORE|10.0",
                  "appSettings": "[concat(createArray(createObject('name', 'ASPNETCORE_ENVIRONMENT', 'value', if(equals(parameters('environmentName'), 'dev'), 'Development', 'Production'))), variables('corsOriginSettings'))]",
                  "connectionStrings": [
                    {
                      "name": "DefaultConnection",
                      "connectionString": "[parameters('sqlConnectionString')]",
                      "type": "SQLAzure"
                    }
                  ]
                }
              },
              "dependsOn": [
                "appServicePlan"
              ]
            }
          },
          "outputs": {
            "webAppName": {
              "type": "string",
              "value": "[variables('webAppName')]"
            },
            "webAppDefaultHostName": {
              "type": "string",
              "value": "[reference('webApp').defaultHostName]"
            }
          }
        }
      },
      "dependsOn": [
        "sql",
        "staticWebApp"
      ]
    }
  },
  "outputs": {
    "apiUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference('appService').outputs.webAppDefaultHostName.value)]"
    },
    "frontendUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference('staticWebApp').outputs.staticWebAppDefaultHostName.value)]"
    },
    "webAppName": {
      "type": "string",
      "value": "[reference('appService').outputs.webAppName.value]"
    },
    "staticWebAppName": {
      "type": "string",
      "value": "[reference('staticWebApp').outputs.staticWebAppName.value]"
    }
  }
}